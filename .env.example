# OpenAI-compatible model configuration (never commit real keys)
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# prompt-constrained JSON by default; set to "json_object" only if the
# compatible endpoint declares support for response_format json_object.
MODEL_JSON_MODE=prompt
# Hard deadline for a single model call in ms (default 300000 = 5 min)
MODEL_TIMEOUT_MS=300000

# Local runtime config
RUNS_DIR=data/runs
APPLE_RSS_PAGE_DELAY_MS=500
REPLAY_EVENT_DELAY_MS=60

# Test-only override (never configured from user input)
# APPLE_RSS_BASE_URL=

# Server-only key for live App Store reviews via SerpApi Apple Reviews;
# save it through Settings or put it in .env.local.
SERPAPI_API_KEY=
# Production must use https://serpapi.com; loopback overrides are for tests only.
# SERPAPI_BASE_URL=http://127.0.0.1:39876
SERPAPI_TIMEOUT_MS=60000
