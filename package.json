{
  "name": "app-review-planner",
  "version": "1.0.0",
  "description": "Local, model-driven analysis of App Store user reviews into evidence-grounded product plans",
  "scripts": {
    "test": "npm run test:unit",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit --project unit:dom",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run check:docs && npm run test:coverage && npm run build",
    "sample:capture": "tsx scripts/capture-real-run.ts",
    "demo:capture": "tsx scripts/build-real-demo.ts",
    "canary:serpapi": "tsx scripts/check-serpapi.ts",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "franc-min": "6.2.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
